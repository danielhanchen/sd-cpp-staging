+// ---- scratch per-node profiler (GGML_CPU_PROF=1), not for shipping ----
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+typedef struct { char key[160]; double t; long n; } gcp_ent;
+#define GCP_N 4096
+static gcp_ent gcp_tab[GCP_N]; static int gcp_used = 0; static int gcp_on = -1;
+static long gcp_seg_runs = 0; static double gcp_seg_t = 0;
+static double gcp_now(void) { struct timespec ts; clock_gettime(CLOCK_MONOTONIC, &ts); return ts.tv_sec + ts.tv_nsec * 1e-9; }
+static int gcp_cmp(const void * a, const void * b) { double x = ((const gcp_ent *) a)->t, y = ((const gcp_ent *) b)->t; return x < y ? 1 : x > y ? -1 : 0; }
+static const char * gcp_tag = "tail";
+static void gcp_dump(void) {
+    if (gcp_used == 0) return;
+    qsort(gcp_tab, GCP_N, sizeof(gcp_ent), gcp_cmp);
+    double tot = 0; for (int i = 0; i < gcp_used; i++) tot += gcp_tab[i].t;
+    fprintf(stderr, "GCP_SEG [%s] graphs=%ld node_sum_s=%.3f graph_wall_s=%.3f\n", gcp_tag, gcp_seg_runs, tot, gcp_seg_t);
+    for (int i = 0; i < gcp_used; i++) {
+        if (gcp_tab[i].t / tot < 0.002 && i > 40) break;
+        fprintf(stderr, "GCP %8.3f s %5.1f%% n=%-7ld %s\n", gcp_tab[i].t, 100 * gcp_tab[i].t / tot, gcp_tab[i].n, gcp_tab[i].key);
+    }
+    memset(gcp_tab, 0, sizeof gcp_tab);
+    gcp_used = 0; gcp_seg_runs = 0; gcp_seg_t = 0;
+}
+__attribute__((visibility("default"))) void ggml_cpu_prof_tag(const char * tag);
+void ggml_cpu_prof_tag(const char * tag) { static char b[200]; snprintf(b, sizeof b, "%s", tag); gcp_tag = b; gcp_dump(); gcp_tag = "tail"; }
+static void gcp_add(const char * key, double t) {
+    unsigned h = 5381; for (const char * c = key; *c; c++) h = h * 33 + (unsigned char) *c;
+    for (int i = 0; i < GCP_N; i++) {
+        int j = (h + i) % GCP_N;
+        if (gcp_tab[j].key[0] == 0) { snprintf(gcp_tab[j].key, sizeof gcp_tab[j].key, "%s", key); gcp_tab[j].t = t; gcp_tab[j].n = 1; gcp_used++; return; }
+        if (strcmp(gcp_tab[j].key, key) == 0) { gcp_tab[j].t += t; gcp_tab[j].n++; return; }
+    }
+}
+static void gcp_key(const struct ggml_tensor * node, int n_fused, char * buf, size_t len) {
+    const struct ggml_tensor * a = node->src[0]; const struct ggml_tensor * b = node->src[1];
+    int o = snprintf(buf, len, "%s%s %s", ggml_op_desc(node), n_fused > 0 ? "+FUSED" : "", ggml_type_name(node->type));
+    if (a) o += snprintf(buf + o, len - o, " a=%s[%lld,%lld,%lld,%lld]%s", ggml_type_name(a->type), (long long) a->ne[0], (long long) a->ne[1], (long long) a->ne[2], (long long) a->ne[3], ggml_is_contiguous(a) ? "" : "nc");
+    if (b && o < (int) len) o += snprintf(buf + o, len - o, " b=%s[%lld,%lld,%lld,%lld]%s", ggml_type_name(b->type), (long long) b->ne[0], (long long) b->ne[1], (long long) b->ne[2], (long long) b->ne[3], ggml_is_contiguous(b) ? "" : "nc");
+}
