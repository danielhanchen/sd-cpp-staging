+// Tiles of rows x activation columns: the rows are split over the threads first (each thread then walks all
+// columns of its row range, 64 rows x up to 8 columns per kernel call); with fewer than 16 rows per thread the
+// columns are split too.
+void iqk_mul_mat_tiles(const mul_mat_t * funcs, int64_t Nx, int64_t Ny, int64_t ne00, const void * A, size_t stride_A,
+                       const void * B, size_t stride_B, float * C, size_t stride_C, int ith, int nth) {
+    const int nx = (int) Nx;
+    const int ny = (int) Ny;
+    int ntile_x = nth < nx/16 ? nth : (nx/16 > 0 ? nx/16 : 1);
+    int ntile_y = nth/ntile_x;
+    if (ntile_y > (ny + 7)/8) ntile_y = (ny + 7)/8;
+    if (ntile_y < 1) ntile_y = 1;
+    const int ntile = ntile_x*ntile_y;
+    for (int itile = ith; itile < ntile; itile += nth) {
+        const int jx = itile % ntile_x;
+        const int jy = itile / ntile_x;
+        const int ix0 = (int)((int64_t) jx      * nx / ntile_x);
+        const int ix1 = (int)((int64_t)(jx + 1) * nx / ntile_x);
+        const int iy0 = (int)((int64_t) jy      * ny / ntile_y);
+        const int iy1 = (int)((int64_t)(jy + 1) * ny / ntile_y);
+        if (ix1 <= ix0 || iy1 <= iy0) {
+            continue;
+        }
+        DataInfo info{C + ix0, (const char *) B, stride_C, stride_B, iy0};
+        iqk_mul_mat_NxM(funcs, (int) ne00, (const char *) A + ix0*stride_A, stride_A, info, ix1 - ix0, iy1);
+    }
+}
+
 #endif // IQK_IMPLEMENT
 
 } // namespace
