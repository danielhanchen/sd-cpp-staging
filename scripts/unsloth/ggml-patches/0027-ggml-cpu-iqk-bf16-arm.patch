     // nb01 >= nb00 - src0 is not transposed
     //   compute by src0 rows
 
+#if defined(__aarch64__)
+    // BF16 weights on ARM: ggml_vec_dot_bf16 has no NEON path (a scalar loop with a double accumulator after src1 is
+    // converted to BF16), so the iqk kernel takes the F32 activations as they are.
+    if (!params->use_ref && src0->type == GGML_TYPE_BF16 && src1->type == GGML_TYPE_F32 && dst->type == GGML_TYPE_F32 &&
+        ggml_is_contiguous(src1) && ne00 % 4 == 0 && ggml_cpu_iqk_type_enabled(GGML_TYPE_BF16)) {
+        const int64_t r2b = ne12 / ne02;
+        const int64_t r3b = ne13 / ne03;
+        bool done = true;
+        for (int64_t i13 = 0; i13 < ne13 && done; i13++) {
+            for (int64_t i12 = 0; i12 < ne12 && done; i12++) {
+                const char * a = (const char *) src0->data + i12/r2b*nb02 + i13/r3b*nb03;
+                const float * b = (const float *) ((const char *) src1->data + i12*nb12 + i13*nb13);
+                float * c = (float *) ((char *) dst->data + i12*nb2 + i13*nb3);
+                done = ggml_cpu_iqk_mul_mat_bf16(ne01, ne11, ne00, a, nb01, b, nb11, c, nb1/sizeof(float), ith, nth);
+            }
+        }
+        if (done) {
+            return;
+        }
+    }
+#endif
